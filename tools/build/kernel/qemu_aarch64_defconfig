# Linux kernel config for QEMU aarch64 virt machine
# Based on defconfig with QEMU-specific options

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_BSD_PROCESS_ACCT=y
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_BLK_DEV_INITRD=y

# Architecture
CONFIG_ARCH_VIRT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8

# Platform - QEMU virt
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NF_NAT=y
CONFIG_BRIDGE=m

# Wireless (for virtual WiFi support)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_LEDS=y

# Block devices
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# SCSI
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y

# Network device support
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_VETH=y

# Input
CONFIG_INPUT_EVDEV=y

# Serial / Console
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Virtio
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y

# GPIO
CONFIG_GPIOLIB=y

# RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# Filesystem
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VFAT_FS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# 9P transport (for host directory sharing)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# DRM/Display (for future GUI)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# Sound (virtio)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# Random number generator
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Crypto
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y

# Printk / Debug
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
