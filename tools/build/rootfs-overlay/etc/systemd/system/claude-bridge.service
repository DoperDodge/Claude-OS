[Unit]
Description=Claude-OS Bridge API
After=network.target wifi-manager.service dbus.service
Requires=wifi-manager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/claude-os/bridge/server.py
Restart=on-failure
RestartSec=5
Environment=CLAUDE_OS_CONFIG=/etc/claude-os
Environment=BRIDGE_HOST=127.0.0.1
Environment=BRIDGE_PORT=8080

[Install]
WantedBy=multi-user.target
