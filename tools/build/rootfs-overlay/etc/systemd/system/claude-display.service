[Unit]
Description=Claude-OS Display Manager
After=claude-bridge.service
Wants=claude-bridge.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/claude-os/display-manager/display_manager.py
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DISPLAY_WIDTH=1080
Environment=DISPLAY_HEIGHT=2340
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
